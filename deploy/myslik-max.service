[Unit]
Description=Myslik MAX bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=myslik
Group=myslik
WorkingDirectory=/opt/myslik/bot
EnvironmentFile=/etc/myslik/myslik.env
Environment=SSL_CERT_FILE=/opt/myslik/certs/max-ca.pem
ExecStart=/opt/myslik/bot/.venv/bin/python max_bot.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/myslik

[Install]
WantedBy=multi-user.target
